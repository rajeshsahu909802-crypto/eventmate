# GEMINI_API_KEY: Required for Google GenAI (Gemma / Gemini) API calls in AI Studio.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_actual_api_key_placeholder"

# GEMMA_API_KEY: Optional dedicated API key override for Gemma API provider.
# Falls back to GEMINI_API_KEY when not set.
GEMMA_API_KEY="your_actual_api_key_placeholder"

# GEMMA_MODEL: Configurable Google Gemma model identifier supported by the Google GenAI API.
# Supported values include: gemma-3-27b-it, gemma-3-12b-it, gemma-3-4b-it, gemini-3.8-flash
GEMMA_MODEL="gemma-3-27b-it"

# GEMMA_API_URL: Official Google Generative Language API endpoint (used by Python FastAPI service).
GEMMA_API_URL="https://generativelanguage.googleapis.com/v1beta/models"

# Request timeout and rate limiting configuration
AI_TIMEOUT_MS="15000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="20"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
